{
  "Logging": {
    "LogLevel": {
      "Default": "Warning",
      "Microsoft.AspNetCore": "Warning",
      "Microsoft.Hosting.Lifetime": "Information"
    }
  },

  "CosmosDb": {
    "AccountEndpoint": "%CosmosDb__AccountEndpoint%",
    "AccountKey": "%CosmosDb__AccountKey%"
  },

  "BlobStorage": {
    "ConnectionString": "%BlobStorage__ConnectionString%"
  },

  "KeyVault": {
    "VaultUri": "%KeyVault__VaultUri%"
  },

  "AppConfiguration": {
    "Endpoint": "%AppConfiguration__Endpoint%"
  },

  "ServiceBus": {
    "ConnectionString": "%ServiceBus__ConnectionString%"
  },

  "EventGrid": {
    "TopicEndpoint": "%EventGrid__TopicEndpoint%",
    "TopicKey": "%EventGrid__TopicKey%"
  },

  "Redis": {
    "ConnectionString": "%Redis__ConnectionString%"
  },

  "ApplicationInsights": {
    "ConnectionString": "%ApplicationInsights__ConnectionString%"
  }
}
