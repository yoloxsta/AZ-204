{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Microsoft.Hosting.Lifetime": "Information"
    }
  },
  "AllowedHosts": "*",

  "CosmosDb": {
    "AccountEndpoint": "https://localhost:8081",
    "AccountKey": "<your-cosmos-db-key>",
    "DatabaseName": "OrderFlowDb",
    "ContainerName": "Orders"
  },

  "BlobStorage": {
    "ConnectionString": "DefaultEndpointsProtocol=https;AccountName=<your-storage-account>;AccountKey=<your-key>;EndpointSuffix=core.windows.net",
    "AccountName": "<your-storage-account>",
    "ContainerName": "order-documents"
  },

  "KeyVault": {
    "VaultUri": "https://<your-keyvault-name>.vault.azure.net/"
  },

  "AppConfiguration": {
    "Endpoint": "https://<your-appconfig-name>.azconfig.io",
    "EnableFeatureFlags": true
  },

  "ServiceBus": {
    "ConnectionString": "<your-servicebus-connection-string>",
    "QueueName": "order-queue",
    "TopicName": "order-events",
    "SubscriptionName": "order-processor"
  },

  "EventGrid": {
    "TopicEndpoint": "https://<your-eventgrid-topic>.eastus-1.eventgrid.azure.net/api/events",
    "TopicKey": "<your-eventgrid-key>"
  },

  "Redis": {
    "ConnectionString": "<your-redis-connection-string>",
    "InstanceName": "OrderFlow_",
    "DefaultExpirationMinutes": 30
  },

  "ApplicationInsights": {
    "InstrumentationKey": "<your-instrumentation-key>",
    "ConnectionString": "InstrumentationKey=<your-key>;IngestionEndpoint=https://<your-region>.in.applicationinsights.azure.com/"
  },

  "OrderSettings": {
    "MaxItemsPerOrder": 50,
    "StaleOrderHours": 24,
    "EnableEmailNotifications": false
  }
}
